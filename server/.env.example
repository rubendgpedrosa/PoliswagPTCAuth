# Copy this file to server/.env for local development, or place a .env file
# beside the compiled poliswag-passport binary. All values are optional.

HOST=0.0.0.0
PORT=5090
WSS_PORT=5443

# 10 minutes. This gives you time to solve Imperva/captcha before Dragonite gives up.
JOB_TIMEOUT_MS=600000

# Optional. Only enable if Dragonite can send header x-auth-secret.
# AUTH_SECRET=change-me

# Optional. Needed only for browsers/profiles that require wss:// from the
# extension control tab. Usually generated by `poliswag-passport cert`; set
# these only if you want to use your own certificate files.
# TLS_KEY=/path/to/127.0.0.1.key
# TLS_CERT=/path/to/127.0.0.1.crt
